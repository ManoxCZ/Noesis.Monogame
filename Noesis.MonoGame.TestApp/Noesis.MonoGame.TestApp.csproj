<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>
	<PropertyGroup>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<Nullable>enable</Nullable>

		<!-- Detected OS family, selects the MonoGame.Runtime.* package: Windows, Linux or Mac -->
		<MonoGameOS Condition="'$(OS)' == 'Windows_NT'">Windows</MonoGameOS>
		<MonoGameOS Condition="'$(OS)' != 'Windows_NT' And Exists('/System/Library/CoreServices/SystemVersion.plist')">Mac</MonoGameOS>
		<MonoGameOS Condition="'$(MonoGameOS)' == ''">Linux</MonoGameOS>

		<!-- MonoGame.Runtime.* package suffix matching $(MonoGamePlatform) from Directory.Build.props:
		     DesktopGL/DesktopGL4 -> DesktopGL4, DesktopVK/Vulkan -> Vulkan, WindowsDX12/WindowsDX/DX12 -> DX12 -->
		<MonoGameRuntimeBackend Condition="'$(MonoGamePlatform)' == 'DesktopGL' Or '$(MonoGamePlatform)' == 'DesktopGL4'">DesktopGL4</MonoGameRuntimeBackend>
		<MonoGameRuntimeBackend Condition="'$(MonoGamePlatform)' == 'DesktopVK' Or '$(MonoGamePlatform)' == 'Vulkan'">Vulkan</MonoGameRuntimeBackend>
		<MonoGameRuntimeBackend Condition="'$(MonoGamePlatform)' == 'WindowsDX12' Or '$(MonoGamePlatform)' == 'WindowsDX' Or '$(MonoGamePlatform)' == 'DX12'">DX12</MonoGameRuntimeBackend>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageReference Include="MonoGame.Runtime.$(MonoGameOS).$(MonoGameRuntimeBackend)" Version="3.8.6" />
		<PackageReference Include="Noesis.GUI" Version="4.0.0" />
		<PackageReference Include="Noesis.App" Version="4.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Noesis.MonoGame\Noesis.MonoGame.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="GUI\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
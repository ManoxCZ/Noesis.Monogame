<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Noesis.MonoGame</id>
    <version>4.0.1</version>
    <title>Noesis.MonoGame</title>
    <authors>Marek Novosad</authors>
    <owners>Marek Novosad</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/ManoxCZ/Noesis.Monogame</projectUrl>
    <repository url="https://github.com/ManoxCZ/Noesis.Monogame.git" type="git" />
    <description>NoesisUI integration into MonoGame framework using the "native" Noesis renderer. Supports all three MonoGame graphics backends: OpenGL 4, Vulkan, and DirectX 12.</description>
    <copyright>Copyright 2023-2026 (c) Marek Novosad. All rights reserved.</copyright>
    <tags>noesis noesisui monogame gui xaml</tags>
    <dependencies>
      <group targetFramework=".NETCoreApp10.0">
        <dependency id="Noesis.GUI" version="4.0.0" />
        <dependency id="MonoGame.Framework.Native" version="3.8.6" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.13" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <!-- README file (will be shown as package README on nuget.org) -->
    <file src="readme" target="readme.md" />
    
    <!-- Main assembly and symbols -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\Noesis.MonoGame.dll" target="lib\net10.0\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\Noesis.MonoGame.pdb" target="lib\net10.0\" />
    
    <!-- Native Noesis libraries for all platforms -->
    <!-- Windows -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\win-x64\native\Noesis.dll" target="runtimes\win-x64\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\win-x86\native\Noesis.dll" target="runtimes\win-x86\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\win10-x64\native\Noesis.dll" target="runtimes\win10-x64\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\win10-x86\native\Noesis.dll" target="runtimes\win10-x86\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\win10-arm\native\Noesis.dll" target="runtimes\win10-arm\native\" />
    
    <!-- macOS -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\osx-x64\native\Noesis.dylib" target="runtimes\osx-x64\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\osx-arm64\native\Noesis.dylib" target="runtimes\osx-arm64\native\" />
    
    <!-- Linux -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\linux-x64\native\libNoesis.so" target="runtimes\linux-x64\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\linux-arm64\native\libNoesis.so" target="runtimes\linux-arm64\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\linux-arm\native\libNoesis.so" target="runtimes\linux-arm\native\" />
    
    <!-- Android -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\android-arm\native\libNoesis.so" target="runtimes\android-arm\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\android-arm64\native\libNoesis.so" target="runtimes\android-arm64\native\" />
    
    <!-- iOS -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\ios\native\libNoesis.a" target="runtimes\ios\native\" />
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\runtimes\ios\native\Symbols.cpp" target="runtimes\ios\native\" />
    
    <!-- Content files -->
    <file src="..\Noesis.MonoGame\bin\Release\net10.0\publish\Content\**\*.*" target="content\" />
  </files>
</package>

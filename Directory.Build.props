<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU;x64</Platforms>
		<Configurations>Debug;Release</Configurations>
		<Nullable>enable</Nullable>
		<Version>4.0.1</Version>
		<MonoGamePlatform>DesktopGL</MonoGamePlatform>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>		
		<Authors>Marek Novosad</Authors>
 		<Description>NoesisUI integration into MonoGame framework, "native" Noesis renderer.</Description>
 		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance> 	
		<PackageProjectUrl>https://github.com/ManoxCZ/Noesis.Monogame</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ManoxCZ/Noesis.Monogame.git</RepositoryUrl> 
    	<RepositoryType>git</RepositoryType>	
 		<Copyright>Copyright 2023-2026 (c) Marek Novosad. All rights reserved.</Copyright>
 		<PackageTags>noesis noesisui monogame</PackageTags>		
	</PropertyGroup>
</Project>
